NEXT_PUBLIC_API_URL=https://your-api-url.com/wp-json/wc/v3/
NEXT_PUBLIC_WP_URL=https://your-wp-url.com/wp-json/wp/v2/
NEXT_PUBLIC_CONSUMER_KEY=ck_your_consumer_key_here
NEXT_PUBLIC_CONSUMER_SECRET=cs_your_consumer_secret_here

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Feature Flags - Show/Hide Sections
# Set to 'true' to show the section, leave unset or set to 'false' to hide
NEXT_PUBLIC_SHOW_TESTIMONIAL=false
NEXT_PUBLIC_SHOW_NEW_IN_INSTAGRAM=false
NEXT_PUBLIC_SHOW_TEMUKAN_KAMI=false
NEXT_PUBLIC_SHOW_STORE_LOCATION=false